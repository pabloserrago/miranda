<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required Reason APIs used by the app -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- Read/write the app's own defaults -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>

	<!-- No data is collected or sent off-device: the Supabase backend
	     (analytics upload + feedback) is disabled via Secrets.supabaseEnabled.
	     If it is re-enabled, restore OtherUsageData + OtherUserContent here. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- App does not track users across other apps or websites -->
	<key>NSPrivacyTracking</key>
	<false/>
</dict>
</plist>
