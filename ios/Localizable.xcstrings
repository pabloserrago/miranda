    "To capture notes with your voice, allow microphone and speech recognition access in Settings. You can still type your note." : {
      "comment" : "Text displayed in a modal alert.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para capturar notas con la voz, permite el acceso al micrófono y al reconocimiento de voz en Ajustes. Aun así, puedes escribir tu nota."
          }
        },
        "ca-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para capturar notas con la voz, permite el acceso al micrófono y al reconocimiento de voz en Ajustes. Aun así, puedes escribir tu nota."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube in den Einstellungen den Zugriff auf Mikrofon und Spracherkennung, um Notizen per Stimme zu erfassen. Du kannst deine Notiz weiterhin eintippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para capturar notas con la voz, permite el acceso al micrófono y al reconocimiento de voz en Ajustes. Aun así, puedes escribir tu nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour capturer des notes à la voix, autorisez l’accès au micro et à la reconnaissance vocale dans Réglages. Vous pouvez toujours saisir votre note."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef in Instellingen toegang tot de microfoon en spraakherkenning om notities met je stem vast te leggen. Je kunt je notitie nog wel typen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para capturar notas com a voz, permite o acesso ao microfone e ao reconhecimento de voz nas Definições. Podes escrever a nota."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para capturar notas con la voz, permite el acceso al micrófono y al reconocimiento de voz en Ajustes. Aun así, puedes escribir tu nota."
          }
        }
      }
    },
