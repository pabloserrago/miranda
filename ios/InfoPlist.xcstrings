    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Write Only Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Miranda adds note details to calendar events when you choose to."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone permission prompt shown by iOS when the user first enables voice input.",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda utilitza el micròfon per a l'entrada de veu, de manera que puguis capturar notes parlant."
          }
        },
        "ca-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda utilitza el micròfon per a l'entrada de veu, de manera que puguis capturar notes parlant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda verwendet das Mikrofon für die Spracheingabe, damit du Notizen durch Sprechen erfassen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda uses the microphone for voice input so you can capture notes by speaking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda usa el micrófono para la entrada de voz, de modo que puedas capturar notas hablando."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda usa el micrófono para la entrada de voz, de modo que puedas capturar notas hablando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda utilise le micro pour la saisie vocale, afin que vous puissiez capturer vos notes en parlant."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda gebruikt de microfoon voor spraakinvoer, zodat je notities kunt vastleggen door te praten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Miranda usa o microfone para entrada de voz, para que possas capturar notas a falar."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Speech recognition permission prompt shown by iOS when the user first starts voice capture.",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda transcriu la teva veu al mateix dispositiu perquè puguis capturar notes parlant. L'àudio no s'emmagatzema ni s'envia enlloc."
          }
        },
        "ca-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda transcriu la teva veu al mateix dispositiu perquè puguis capturar notes parlant. L'àudio no s'emmagatzema ni s'envia enlloc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda transkribiert deine Sprache direkt auf dem Gerät, damit du Notizen durch Sprechen erfassen kannst. Audio wird nie gespeichert oder übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda transcribes your speech on-device so you can capture notes by talking. Audio is never stored or sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda transcribe tu voz en el propio dispositivo para que puedas capturar notas hablando. El audio nunca se almacena ni se envía a ningún sitio."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda transcribe tu voz en el propio dispositivo para que puedas capturar notas hablando. El audio nunca se almacena ni se envía a ningún lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda transcrit votre voix directement sur l’appareil pour que vous puissiez capturer vos notes en parlant. L’audio n’est jamais conservé ni envoyé où que ce soit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miranda zet je spraak op het apparaat zelf om in tekst, zodat je notities kunt vastleggen door te praten. Audio wordt nooit opgeslagen of verstuurd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Miranda transcreve a tua voz no próprio dispositivo para que possas capturar notas a falar. O áudio nunca é guardado nem enviado para nenhum lugar."
          }
        }
      }
    }
  },
  "version" : "1.0"
